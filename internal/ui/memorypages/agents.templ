package memorypages

import (
	"fmt"
	"strconv"

	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/textarea"
	"github.com/templui/templui/internal/memory"
)

templ AgentsList(agents []*memory.Agent, memoryCounts map[string]int, storageBackend string) {
	@MemoryAppLayout("Agents", "agents", storageBackend) {
		<div class="max-w-6xl mx-auto space-y-6">
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-3">
					<h1 class="text-2xl font-bold tracking-tight">Agents</h1>
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						{ strconv.Itoa(len(agents)) }
					}
				</div>
				@button.Button(button.Props{Href: "/memory/agents/new", Size: button.SizeSm}) {
					@icon.Plus(icon.Props{Class: "size-4"})
					New Agent
				}
			</div>
			if len(agents) == 0 {
				<div class="flex flex-col items-center justify-center py-24 text-muted-foreground">
					@icon.Bot(icon.Props{Class: "size-14 opacity-20 mb-4"})
					<p class="text-sm font-medium">No agents registered yet</p>
					<p class="text-xs mt-1 mb-6">Create your first agent to start storing memories.</p>
					@button.Button(button.Props{Href: "/memory/agents/new", Variant: button.VariantOutline}) {
						@icon.Plus(icon.Props{Class: "size-4"})
						New Agent
					}
				</div>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
					for _, a := range agents {
						{{ count := memoryCounts[a.ID] }}
						@card.Card(card.Props{Class: "hover:shadow-md transition-shadow"}) {
							@card.Content(card.ContentProps{Class: "p-5"}) {
								<div class="flex items-start gap-3 mb-4">
									<div class="p-2.5 bg-primary/10 rounded-lg shrink-0">
										@icon.Bot(icon.Props{Class: "size-5 text-primary"})
									</div>
									<div class="flex-1 min-w-0">
										<h3 class="font-semibold text-base truncate">{ a.Name }</h3>
										if a.Description != "" {
											<p class="text-sm text-muted-foreground mt-0.5 line-clamp-2">{ a.Description }</p>
										}
									</div>
								</div>
								<div class="flex items-center justify-between pt-3 border-t">
									<div class="flex items-center gap-2">
										@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
											{ strconv.Itoa(count) }
											if count == 1 {
												memory
											} else {
												memories
											}
										}
									</div>
									<span class="text-xs text-muted-foreground">{ a.CreatedAt.Format("Jan 2, 2006") }</span>
								</div>
								<div class="mt-3">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/memory/memories?agentId=%s", a.ID)) }
										class="inline-flex items-center gap-1.5 text-xs font-medium text-primary hover:underline transition-colors"
									>
										@icon.Eye(icon.Props{Class: "size-3.5"})
										View Memories
									</a>
								</div>
							}
						}
					}
				</div>
			}
		</div>
	}
}

templ AgentForm(storageBackend string) {
	@MemoryAppLayout("New Agent", "agents", storageBackend) {
		<div class="max-w-2xl mx-auto space-y-6">
			<div class="flex items-center gap-2">
				<a
					href="/memory/agents"
					class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
				>
					@icon.ArrowLeft(icon.Props{Class: "size-4"})
					Back to Agents
				</a>
			</div>
			@card.Card() {
				@card.Header() {
					@card.Title() {
						New Agent
					}
					<p class="text-sm text-muted-foreground mt-1">Register a new agent to associate memories with.</p>
				}
				@card.Content(card.ContentProps{Class: "pt-6"}) {
					<form action="/memory/agents" method="POST" class="space-y-5">
						<div class="space-y-1.5">
							<label for="name" class="text-sm font-medium">Name</label>
							@input.Input(input.Props{
								ID:          "name",
								Name:        "name",
								Placeholder: "e.g. Research Agent, Support Bot…",
								Required:    true,
							})
							<p class="text-xs text-muted-foreground">A unique, human-readable name for this agent.</p>
						</div>
						<div class="space-y-1.5">
							<label for="description" class="text-sm font-medium">Description</label>
							@textarea.Textarea(textarea.Props{
								ID:          "description",
								Name:        "description",
								Placeholder: "Describe what this agent does and what kinds of memories it stores…",
								Rows:        4,
							})
						</div>
						<div class="flex items-center justify-between pt-2 border-t">
							<a
								href="/memory/agents"
								class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
							>
								Cancel
							</a>
							@button.Button(button.Props{Type: button.TypeSubmit}) {
								@icon.Plus(icon.Props{Class: "size-4"})
								Create Agent
							}
						</div>
					</form>
				}
			}
		</div>
	}
}
